# direnv configuration. Entering the repository activates the Nix dev shell, so the
# toolchain is on PATH without having to remember `nix develop`.
#
# Install direnv, then run `direnv allow` once in this directory. Nothing happens until
# you opt in.

use flake

# Machine-local overrides, not tracked by git
if [ -f .envrc.local ]; then
  source_env .envrc.local
fi
